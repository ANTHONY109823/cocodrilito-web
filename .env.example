# Vercel (Production): configurar en Project Settings → Environment Variables
# NEXT_PUBLIC_API_URL=https://cocodrilito-backend-production.up.railway.app/api
# API_URL=https://cocodrilito-backend-production.up.railway.app/api

# URL base del API backend (incluye /api)
# Desarrollo local directo al backend:
# NEXT_PUBLIC_API_URL=http://localhost:5034/api
#
# Desarrollo con proxy same-origin (recomendado para cookies/impersonación):
# NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_URL=http://localhost:5034/api

# Solo para rewrites en next.config.ts (servidor)
API_URL=http://localhost:5034/api
