{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "functions": {
    "src/app/api/[...path]/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/health/route.ts": {
      "maxDuration": 10
    }
  }
}
